<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="315"
                        android:endColor="#1C2030"
                        android:startColor="#2A2F45" />
                    <stroke android:width="3dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:endColor="#11131B"
                android:startColor="#1A1D29" />
            <stroke android:width="1dp" android:color="#23273A" />
        </shape>
    </item>
</selector>
