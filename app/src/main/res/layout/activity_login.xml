<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="72dp"
    android:paddingTop="40dp"
    android:paddingEnd="72dp"
    android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_extrabold"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:text="VIEW"
            android:textColor="@color/text"
            android:textSize="104sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_bold"
            android:text="Live-TV. Neu gedacht."
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_medium"
            android:lineSpacingExtra="4dp"
            android:maxWidth="380dp"
            android:text="Melde dich mit den Xtream-Codes-Zugangsdaten deines IPTV-Anbieters an. Du findest sie in der Mail deines Anbieters."
            android:textColor="@color/text2"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="@font/inter_medium"
            android:text="Entwickelt von Erlin Ramaj"
            android:textColor="@color/text3"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="430dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="26dp"
            android:paddingEnd="30dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="Anmelden"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.08"
                android:text="XTREAM CODES API"
                android:textColor="@color/accent2"
                android:textSize="11sp" />

            <TextView
                style="@style/ViewLabel"
                android:text="Server-URL" />

            <EditText
                android:id="@+id/server"
                style="@style/ViewInput"
                android:hint="http://server.com:8080"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView
                style="@style/ViewLabel"
                android:text="Benutzername" />

            <EditText
                android:id="@+id/user"
                style="@style/ViewInput"
                android:hint="Benutzername"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword" />

            <TextView
                style="@style/ViewLabel"
                android:text="Passwort" />

            <EditText
                android:id="@+id/pass"
                style="@style/ViewInput"
                android:hint="Passwort"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/error"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:nextFocusDown="@+id/loginBtn"
                android:text="Anmelden"
                android:textColor="@color/button_text"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
